# FleetShell MDM portal (dev) -- environment
# Copy to .env for `vite dev`. Values assume an SSH/SSM port-forward mapping
# each cluster to a localhost port (global -> 5432, local -> 5433).
#
# Discrete fields (NOT a URL) so passwords with / + @ = are safe verbatim.

# --- Global plane (master data + authz); prod: RDS Proxy host ---
GLOBAL_DB_HOST=localhost
GLOBAL_DB_PORT=5432
GLOBAL_DB_NAME=fleetshell
GLOBAL_DB_USER=fsadmin
GLOBAL_DB_PASSWORD=your-global-MASTER_PW

# --- Regional plane (user PII + group membership) ---
LOCAL_DB_HOST=localhost
LOCAL_DB_PORT=5433
LOCAL_DB_NAME=fleetshell_local
LOCAL_DB_USER=fsadmin
LOCAL_DB_PASSWORD=local-password-from-secrets-manager

# TLS: require (dev) | verify-full (prod, needs PGSSLROOTCERT) | disable
PGSSL=require

# Connection pool size per plane.
PG_POOL_MAX=10

# Base path (SvelteKit + ws). '/dev' now; set '' at root cutover.
BASE_PATH=/dev

# Dev-only default user for the index page / API:
# alice (ccc_de_military): aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaa0001
# bob   (ccc_us):          bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbb0001
DEV_USER_ID=aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaa0001

# adapter-node origin (CSRF). Public URL in production.
ORIGIN=http://localhost:5173

# Dev session cookie signing key (replace with a strong secret; real SAML/OAuth later).
SESSION_SECRET=dev-session-secret-change-me

# Valkey (data-classification cache for aeroftp). rediss:// = TLS.
VALKEY_URL=rediss://localhost:6380
VALKEY_TLS_REJECT_UNAUTHORIZED=false

# ---- Client tunnels + enrollment (Support page) ----------------------------
# HMAC secret for tunnel + probe JWTs. MUST be identical to the gateway's
# JWT_SECRET (see AGENTS.md section 6).
JWT_SECRET=change-me-in-production

# Port the FleetShell Windows client's local API listens on (PUBLIC_* = exposed
# to browser + SSR). Used by the device Connect tab.
PUBLIC_CLIENT_API_PORT=58596

# Phase-1 shared client identity: the wildcard *.client.fleetshell.com cert
# chain + private key handed to every enrolled client (PEM). In production these
# come from AWS Secrets Manager; for dev paste the PEM inline.
CLIENT_CERT=
CLIENT_KEY=

# Support-page installer downloads: absolute (or cwd-relative) paths on disk.
DOWNLOAD_FLEETSHELL_CLIENT=
DOWNLOAD_VNC_VIEWER=
DOWNLOAD_TEAMVIEWER_CLIENT=
DOWNLOAD_SSH_TERMINAL=

# Fallback download URL shown when a corporate scanner (ZScaler) blocks the
# portal download. Empty hides the GitHub fallback button.
PUBLIC_GITHUB_RELEASE_URL=

# NOTE: the FleetShell client's "Portal URL" setting must include the /dev base
# path (e.g. https://host/dev) so its /api/... and /api/login calls resolve.
